{
  "name": "dsh-tui-plugin",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone dsh TUI plugin project, extracted from the deepseek-harness worktree (not merged upstream)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjiangao/dsh-tui-plugin.git"
  },
  "scripts": {
    "link:harness": "node scripts/link-harness.mjs",
    "link:harness:revert": "node scripts/link-harness.mjs --revert",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -p packages/tui/tsconfig.json --noEmit && tsc -p packages/tui-app/tsconfig.json --noEmit",
    "build": "pnpm --filter @deepseek-ai/dsh-tui run build && pnpm --filter @deepseek-ai/dsh-tui-app run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "oxlint": "1.76.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
